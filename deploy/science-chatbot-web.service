[Unit]
Description=Science Chatbot Web App
After=network.target

[Service]
Type=simple
# Template: set User, WorkingDirectory, ExecStart, and PUBLIC_ORIGIN locally.
User=science-chatbot
WorkingDirectory=/opt/science-chatbot
Environment=HOST=127.0.0.1
Environment=PORT=11436
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen3:8b
Environment=PUBLIC_ORIGIN=https://chatbot.example.com
# Run npm ci and npm run build before starting or restarting this service.
ExecStart=/opt/science-chatbot/backend/target/release/science-chatbot-server
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
