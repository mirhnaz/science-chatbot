[Unit]
# A systemd *user* service: runs as the checkout's owner, so deploys need no
# sudo (`systemctl --user restart curio-web`). See docs/INSTALL.md → "Run as a
# user service". Needs `loginctl enable-linger` once to start at boot.
Description=Curio Web App (user service)
After=network.target

[Service]
Type=simple
# Template: %h is your home directory; set PUBLIC_ORIGIN locally (the
# INSTALL.md steps copy it from the existing system unit).
WorkingDirectory=%h/dev/science-chatbot
Environment=HOST=127.0.0.1
Environment=PORT=11436
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=gemma4:12b
Environment=PUBLIC_ORIGIN=https://curio.example.com
# Run npm ci and npm run build before starting or restarting this service.
ExecStart=%h/dev/science-chatbot/backend/target/release/curio-server
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5s

# Sandbox: the server is reachable from the internet, so it gets only what it
# needs. It sees an empty home directory except the four folders below, all
# read-only, and cannot gain privileges or write anywhere on disk.
# A new asset folder in http.rs must be added to BindReadOnlyPaths.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/dev/science-chatbot/public %h/dev/science-chatbot/build/client %h/dev/science-chatbot/backend/data %h/dev/science-chatbot/backend/target/release
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=default.target
