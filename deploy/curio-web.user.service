[Unit]
# A systemd *user* service: runs as the checkout's owner, so deploys need no
# sudo (`systemctl --user restart curio-web`). See docs/INSTALL.md → "Run as a
# user service". Needs `loginctl enable-linger` once to start at boot.
Description=Curio Web App (user service)
After=network.target

[Service]
Type=simple
# Template: %h is your home directory; set PUBLIC_ORIGIN locally (the
# INSTALL.md steps copy it from the existing system unit).
WorkingDirectory=%h/dev/science-chatbot
Environment=HOST=127.0.0.1
Environment=PORT=11436
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=qwen3:8b
Environment=PUBLIC_ORIGIN=https://curio.example.com
# Run npm ci and npm run build before starting or restarting this service.
ExecStart=%h/dev/science-chatbot/backend/target/release/curio-server
TimeoutStopSec=10s
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
